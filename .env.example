# Molde das variáveis do projeto. Copie para um arquivo chamado .env e preencha.
# O .env fica só na sua máquina (está no .gitignore) e NUNCA vai para o GitHub.
# No n8n, as chaves são cadastradas em "Credentials", que o próprio n8n criptografa.
# Este arquivo serve de referência do que precisa ser configurado.

# Chave da API do Gemini (criada no Google AI Studio)
GEMINI_API_KEY=

# Token do bot do Telegram (gerado pelo @BotFather)
TELEGRAM_BOT_TOKEN=

# ID do chat que recebe o relatório
TELEGRAM_CHAT_ID=

# E-mail que recebe o relatório
GMAIL_DESTINATARIO=

# ID da planilha do Google Sheets (trecho da URL entre /d/ e /edit)
GOOGLE_SHEETS_ID=
