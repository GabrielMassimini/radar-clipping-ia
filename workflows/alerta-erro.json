    {
      "parameters": {
        "jsCode": "// Monta o aviso de falha com os dados que o n8n entrega ao Error Trigger\nconst { execution, workflow } = $('Error Trigger').first().json;\nconst escapar = (texto) => String(texto || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst mensagem = [\n  `⚠️ <b>${escapar(workflow.name)} falhou</b>`,\n  `Nó: ${escapar(execution.lastNodeExecuted || 'desconhecido')}`,\n  `Erro: ${escapar(execution.error?.message || 'sem mensagem').slice(0, 500)}`,\n  execution.url ? `<a href=\"${escapar(execution.url)}\">Abrir a execução</a>` : null,\n].filter(Boolean).join('\\n');\n\nreturn [{ json: { mensagem } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "ff069d85-8908-441f-a665-89b2b7e76066",
      "name": "Montar alerta"
    },
